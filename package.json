{
    "name": "lyfestyle",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.1.2",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "desktop": "pnpm --filter @lyfestyle/desktop tauri dev",
        "desktop:build": "pnpm --filter @lyfestyle/desktop tauri build",
        "api:dev": "pnpm --filter @lyfestyle/api dev",
        "api:build": "pnpm --filter @lyfestyle/api build",
        "runner": "pnpm --filter @lyfestyle/runner start",
        "db:generate": "pnpm --filter @lyfestyle/api db:generate",
        "secrets": "node scripts/secrets.mjs",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix --deny-warnings",
        "lint:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
        "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
    },
    "devDependencies": {
        "lefthook": "^2.2.2",
        "oxlint": "^1.89.0",
        "prettier": "^3.9.10"
    }
}

# Copy to .env. `pnpm secrets` prints values for the two required secrets.

# --- API (apps/api) ---------------------------------------------------------
# Bearer token every client sends: the desktop app, the runner, Claude Code's MCP connection.
API_TOKEN=
# 32 random bytes, base64. Encrypts Canvas tokens and MCP secrets at rest; changing it orphans them.
ENCRYPTION_KEY=

PORT=3000
# Required Postgres connection string. Use a local database for development, e.g.
# postgresql://postgres:postgres@localhost:5432/postgres (see docs/development.md); pointed at
# production, every local run writes production data.
DATABASE_URL=
# The API's public address, used in the metrics tracker script. On Railway this defaults to
# https://$RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=http://localhost:3000
# Comma-separated browser origins, or * (requests carry a bearer token, not cookies).
CORS_ORIGINS=*
# Websites whose page views POST /metrics/collect records: comma-separated origins, or *.
METRICS_ORIGINS=*
# Page views older than this many days are deleted; 0 keeps them forever.
METRICS_RETENTION_DAYS=365

# Outbound email for the agent's email_send tool and automations' ctx.email.
RESEND_API_KEY=
RESEND_FROM=Lyfestyle <agent@yourdomain.com>
# Your own address: where ctx.email sends when an automation names no recipient.
NOTIFY_EMAIL=

# Most one agent run may spend, in USD; the agent runs one automation run starts share it too.
RUN_BUDGET_USD=5
# An automation's code is stopped after this long (default 15 minutes).
AUTOMATION_TIMEOUT_MS=900000

# --- Runner (apps/runner), runs on your machine ------------------------------
LYFESTYLE_API_URL=http://localhost:3000
# Defaults to API_TOKEN when unset. Stays with the runner: each run's agent gets a scoped token.
LYFESTYLE_API_TOKEN=
# Names this machine on the runs it takes; defaults to the hostname.
RUNNER_ID=
# A run still going after this many minutes is stopped and failed.
RUN_TIMEOUT_MINUTES=30
# claude-code or command. Leave empty: it picks command when AGENT_HARNESS_COMMAND is set.
AGENT_HARNESS=
# Run without a shell: an executable, then its arguments ("quote" ones with spaces). It reads the
# prompt on stdin, takes --session <id>, prints Claude Code stream-json, and must keep to
# LYFESTYLE_MAX_BUDGET_USD and LYFESTYLE_MAX_TURNS, which the runner sets for it.
AGENT_HARNESS_COMMAND=
# Optional Claude model id; defaults to Claude Code's own default.
AGENT_MODEL=
# Built-in Claude Code tools the agent may use, comma-separated, or `none`.
AGENT_TOOLS=WebSearch,WebFetch
# claude.ai connector tools the agent may use (Gmail, Google Calendar, ...), comma-separated, or
# `none`. Unset allows Gmail read-only and Calendar read/write; see apps/runner/src/claude-code.ts.
AGENT_CONNECTOR_TOOLS=
AGENT_MAX_TURNS=50
# Optional lower cap per run in USD, more than 0; each run's own budget from the API applies too.
AGENT_MAX_BUDGET_USD=
# Runs taken at once, a whole number.
RUNNER_CONCURRENCY=1
# Claude Code's working directory, kept apart from your projects. Default ~/.lyfestyle/agent.
AGENT_CWD=

# --- Desktop (apps/desktop) ---------------------------------------------------
# Todo app MCP URL, `https://<host>/mcp/<MCP_SECRET>`. Given to the agent as the `todo` server
# when Settings leaves it empty. Dev builds also read it from this file.
LYFESTYLE_TODO_MCP_URL=
# Folder of `<name>/SKILL.md` skills linked into ~/.claude/skills when Settings leaves the skills
# folder empty. Empty: just list what is already in ~/.claude/skills.
LYFESTYLE_SKILLS_DIR=

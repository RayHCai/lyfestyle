{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Lyfestyle",
    "version": "0.1.0",
    "identifier": "com.lyfestyle.app",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Lyfestyle",
                "width": 1180,
                "height": 780,
                "minWidth": 760,
                "minHeight": 520,
                "center": true,
                "maximized": true,
                "decorations": false,
                "shadow": true,
                "resizable": true,
                "backgroundColor": "#FFFFFF"
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data: blob: asset: http://asset.localhost",
                "font-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*",
                "object-src": "'none'",
                "base-uri": "'self'",
                "frame-src": "'none'"
            },
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-inline'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data: blob: asset: http://asset.localhost",
                "font-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:*",
                "object-src": "'none'",
                "base-uri": "'self'",
                "frame-src": "'none'"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QTg4NkVBOEMxQUM5REQKUldUZHlScU02b2FveHczTE4yNGFmU2NPZUlzR2ZTNk1OZXUxQjlxZ2ZDM0VTaHNYY3EzMHUrRkoK",
            "endpoints": [
                "https://github.com/RayHCai/lyfestyle/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}

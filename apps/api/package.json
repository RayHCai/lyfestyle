{
    "name": "@lyfestyle/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/app.ts",
        "./testing": "./src/testing.ts"
    },
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
        "build": "node build.mjs",
        "start": "node dist/index.js",
        "typecheck": "tsc -p .",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "@electric-sql/pglite": "^0.5.0",
        "@hono/node-server": "^2.1.0",
        "@hono/zod-validator": "^0.9.0",
        "@lyfestyle/shared": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.32.0",
        "croner": "^10.0.0",
        "drizzle-orm": "^0.45.0",
        "hono": "^4.13.0",
        "pg": "^8.23.0",
        "zod": "^4.6.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.0",
        "@types/pg": "^8.23.0",
        "drizzle-kit": "^0.31.0",
        "esbuild": "^0.28.0",
        "tsx": "^4.23.0",
        "typescript": "^7.0.0",
        "vitest": "^5.0.0"
    }
}

{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/runner/Dockerfile",
        "watchPatterns": [
            "apps/runner/**",
            "packages/**",
            "package.json",
            "pnpm-lock.yaml",
            "pnpm-workspace.yaml",
            "tsconfig.base.json",
            ".dockerignore"
        ]
    },
    "deploy": {
        "numReplicas": 1,
        "drainingSeconds": 30,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
